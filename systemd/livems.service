[Unit]
Description=流媒体管理系统后端服务 (livems)
Documentation=file:/www/wwwroot/live.rextian.com/docs/deploy.md
After=network-online.target zlm.service
Wants=network-online.target
Requires=zlm.service

[Service]
Type=simple
User=root
WorkingDirectory=/www/wwwroot/live.rextian.com/backend
ExecStart=/www/wwwroot/live.rextian.com/backend/bin/livems -c /www/wwwroot/live.rextian.com/backend/configs/config.yaml
Restart=always
RestartSec=5
StartLimitBurst=10
StartLimitIntervalSec=60
# 优雅退出，等待 in-flight 请求与后台任务结束
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=append:/www/wwwroot/live.rextian.com/backend/logs/livems.log
StandardError=append:/www/wwwroot/live.rextian.com/backend/logs/livems.log
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
