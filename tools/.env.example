# tools/ 运维诊断脚本的站点私有参数模板
# 复制为 .env.local 后填写；.env.local 已在 .gitignore 中，不会被提交。

# ---- 目标主机 ----
HOST_IP=192.168.1.100            # 部署了 StreamSwitch 的主机内网 IP
SSH_USER=root
# SSH_KEY=tools/livems_key        # 免密私钥路径（默认同目录 livems_key）

# ---- 数据库（与 backend/configs/config.yaml 的 mysql 段一致）----
DB_NAME=streamswitch
DB_USER=streamswitch
DB_PASS=CHANGE_ME

# ---- 后台管理员（验证/测试脚本登录用）----
ADMIN_USER=admin
ADMIN_PASS=CHANGE_ME

# ---- ZLMediaKit api.secret（与 zlm/conf/config.ini 和 config.yaml 的 zlm.secret 一致）----
ZLM_SECRET=CHANGE_ME

# ---- 安装位置（一键部署默认值，一般无需修改）----
# APP_DIR=/opt/streamswitch
# ZLM_DIR=/opt/streamswitch/zlm
# NGX_CONF=/etc/nginx/conf.d/streamswitch.conf
# SVC_APP=streamswitch
# SVC_ZLM=streamswitch-zlm

# ---- 网络（策略路由 / 外网诊断用；不用可留空）----
IFACE=eth0                       # 主机对内网的网卡名
LAN_CIDR=192.168.1.0/24
ROUTER_IP=192.168.1.1            # 做端口映射的路由器
ROUTER_MAC=aa:bb:cc:dd:ee:ff     # 路由器 LAN 口 MAC（ip neigh 可查）
PROXY_GW_IP=                     # 若主机默认网关是另一台代理网关（如跑 Surge 的 Mac），填其 IP
WAN_IP=                          # 路由器公网 IP（外网连通性测试用）
DDNS_DOMAIN=                     # 动态域名（如有）

# ---- 对外端口 ----
WEB_PORT=51880
TLS_PORT=51443
