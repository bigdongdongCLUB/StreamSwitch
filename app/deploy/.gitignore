# =============================================================================
#  迁移产物（不应提交到版本库）
# =============================================================================

# Docker 镜像导出（体积大，按需生成）
deploy/docker/images/
*.tar
*.tar.gz

# 迁移数据（含业务数据与密钥，敏感）
deploy/docker/data/
deploy/baota/dist/

# 环境变量（含明文密码）
deploy/docker/.env

# 证书
deploy/docker/certs/*
!deploy/docker/certs/.gitkeep
deploy/docker/www/*
!deploy/docker/www/.gitkeep

# 运行时生成
deploy/docker/nginx/conf.d/*.conf
